# Copy to .env.local. None of these are secret — the website only reads.

# From sanity.io/manage, or `npx sanity init`.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Pins Sanity API behaviour to a date. Bump deliberately, not automatically.
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-01

# Currency symbol shown before every figure.
NEXT_PUBLIC_CURRENCY=$

# Optional. If set, the masthead links to your Studio.
NEXT_PUBLIC_STUDIO_URL=

# Only needed by `npm run seed`, never by the website. Keep this one secret.
# SANITY_WRITE_TOKEN=
