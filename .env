# Public Sanity config for the Hasaleh site.
# Currency is NOT here — see lib/currency.ts, which also sets decimal places.
#
# Committed on purpose: every value here is already visible in the client bundle,
# so none of it is secret. The project id and dataset identify a PUBLIC dataset
# that the site reads without a token.
#
# Override any of these locally with .env.local (git-ignored).

NEXT_PUBLIC_SANITY_PROJECT_ID=3a03n44v
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-01
NEXT_PUBLIC_STUDIO_URL=https://zawyeh-hasaleh.sanity.studio/
